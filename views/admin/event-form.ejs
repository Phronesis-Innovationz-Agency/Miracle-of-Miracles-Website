<%
  let dateValue = '';
  if (event.event_date) {
    const d = new Date(event.event_date);
    if (!isNaN(d)) dateValue = d.toISOString().slice(0, 10);
    else dateValue = event.event_date;
  }
%>
<%- include('./partials/header', { heading: heading, subheading: 'Photos are shown by dropping a matching filename into public/images/events/.' }) %>

<% if (typeof error !== 'undefined') { %><div class="error-msg"><%= error %></div><% } %>

<form class="card-form" method="POST" action="<%= formAction %>">
  <div class="field">
    <label for="title">Title</label>
    <input type="text" id="title" name="title" value="<%= event.title || '' %>" required />
  </div>
  <div class="field">
    <label for="category">Category</label>
    <select id="category" name="category" required>
      <option value="">Choose one</option>
      <% categories.forEach(function(c) { %>
        <option value="<%= c.key %>" <%= event.category === c.key ? 'selected' : '' %>><%= c.label %></option>
      <% }) %>
    </select>
  </div>
  <div class="field">
    <label for="event_date">Date</label>
    <input type="date" id="event_date" name="event_date" value="<%= dateValue %>" required />
  </div>
  <div class="field">
    <label for="event_time">Time (optional)</label>
    <input type="text" id="event_time" name="event_time" placeholder="e.g. 9:00 AM – 1:00 PM" value="<%= event.event_time || '' %>" />
  </div>
  <div class="field">
    <label for="location">Location (optional)</label>
    <input type="text" id="location" name="location" value="<%= event.location || '' %>" />
  </div>
  <div class="field">
    <label for="description">Description (optional)</label>
    <textarea id="description" name="description"><%= event.description || '' %></textarea>
  </div>
  <div class="field">
    <label for="image_filename">Photo filename (optional)</label>
    <input type="text" id="image_filename" name="image_filename" placeholder="e.g. gospel-mission-2026.jpg" value="<%= event.image_filename || '' %>" />
    <p style="font-size:.8rem;color:var(--ink-soft);margin-top:6px;margin-bottom:0;">
      After saving, drop a photo with this exact filename into <code>public/images/events/</code>.
    </p>
  </div>
  <button class="btn btn-maroon" type="submit"><%= event.id ? 'Save changes' : 'Create event' %></button>
</form>
<p style="margin-top:20px;"><a href="/admin/events">&larr; Back to events</a></p>

<%- include('./partials/footer') %>
