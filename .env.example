# Neon Postgres connection string (create a project at neon.tech, use a separate one from your other apps)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Session cookie signing secret — any long random string
SESSION_SECRET=change-this-to-something-long-and-random

# Admin login (used to view registrations and giving records)
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

PORT=3000
